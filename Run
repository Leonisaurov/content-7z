#!/bin/bash

ubuntu() {
    package=$1
    echo "Ubuntu like:"
    echo -e "\tsudo apt install $package"
}

arch() {
    package=$1
    echo "Archlinux like:"
    echo -e "\tsudo pacman -S $package"
}

if which 7z &> /dev/null; then
    cargo run -- "$@"
else
    echo "The 7z command need to be installed."

    echo "Install it with your package manager:"
    ubuntu "p7zip"
    arch "p7zip"
    echo "Or what you have"
fi
